# vns_api — Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 8000)
PORT=8000
CORS_ORIGINS=

# ─── Auth ────────────────────────────────────────────
# Internal API key for service-to-service communication (vns_api ↔ st0nks_bot)
# Must match INTERNAL_API_KEY in st0nks_bot .env
INTERNAL_API_KEY=
